#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define TBLE_ORTHO   true

#define DEF 0
#define NAV 1
#define SYM 2
#define NUM 3
#define FUN 4
#define MSE 5
#define WIN 6
#define ADM 7
#define WSD 8

// Using layer taps on thumbs, having quick tap as well helps w/ repeating space/backspace
&lt { quick-tap-ms = <200>; };

#define BT(n) BT_SEL n
#define SC(n) LS(LC(n))
#define SA(n) LS(LA(n))
#define CA(n) LC(LA(n))
#define MEH(n) LS(LC(LA(n)))
#define HPR(n) LS(LC(LA(LG(n))))

/ {
    chosen {
       zmk,physical-layout = &technikable_ortho_layout;
    };

    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            display-name = "HOMEROW_MODS";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;                        // <---[[produces tap if held longer than tapping-term-ms]]
            quick-tap-ms = <100>;
            global-quick-tap;
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "Default";
            bindings = <
&kp Q           &kp W           &kp F           &kp P           &kp G           &to WSD         &to WSD         &kp J           &kp L           &kp U           &kp Y           &kp SEMI
&hm LSFT A      &hm LCTL R      &hm LALT S      &hm LGUI T      &kp D           &none           &none           &kp H           &hm RGUI N      &hm RALT E      &hm RCTL I      &hm RSFT O
&kp Z           &kp X           &kp C           &kp V           &kp B           &none           &none           &kp K           &kp M           &kp COMMA       &kp DOT         &kp SLASH
                                &lt WIN ESC     &lt NAV SPACE   &lt NUM RET     &to DEF         &to DEF         &lt FUN BSPC    &lt SYM SPACE   &lt ADM DEL
            >;
        };

        nav_layer {
            display-name = "Nav";
            bindings = <
&none           &none           &none           &none           &none           &none           &none           &none           &kp LS(TAB)     &kp UARW        &kp TAB         &none 
&kp LSHFT       &kp LCTRL       &kp LALT        &kp LGUI        &trans          &trans          &trans          &none           &kp LARW        &kp DARW        &kp RARW        &none 
&none           &none           &none           &kp CAPS        &none           &trans          &trans          &none           &kp HOME        &kp PG_UP       &kp PG_DN       &kp END 
                                &none           &trans          &none           &trans          &trans          &kp BSPC        &kp RET         &kp ESC
            >;
        };

        sym_layer {
            display-name = "Sym";
            bindings = <
&kp EXCL        &kp AT          &kp HASH        &kp DLLR        &kp PRCNT       &none           &none           &none           &kp LT          &kp EQUAL       &kp GT          &kp TILDE
&kp LBRC        &kp RBRC        &kp LPAR        &kp RPAR        &kp UNDER       &trans          &trans          &none           &kp RGUI        &kp RALT        &kp RCTL        &kp RSHFT
&kp LT          &kp GT          &kp LBKT        &kp RBKT        &kp CARET       &trans          &trans          &none           &kp DQT         &kp SQT         &kp GRAVE       &kp BSLH
                                &kp LS(TAB)     &kp ESC         &kp TAB         &trans          &trans          &none           &trans          &none 
            >;
        };

        num_layer {
            display-name = "Num";
            bindings = <
&kp ESC         &kp LG(BSPC)    &kp BSPC        &kp RET         &none           &none           &none           &kp AMPS        &kp N7          &kp N8          &kp N9          &kp PIPE
&kp LSHFT       &kp LCTRL       &kp LALT        &kp LGUI        &kp LS(SEMI)    &trans          &trans          &kp PLUS        &kp N4          &kp N5          &kp N6          &kp MINUS
&kp LG(Z)       &kp LG(X)       &kp LG(C)       &kp LG(V)       &kp LG(A)       &trans          &trans          &kp ASTRK       &kp N1          &kp N2          &kp N3          &kp SLASH
                                &none           &none           &trans          &trans          &trans          &kp EQUAL       &kp N0          &kp DOT
            >;
        };

        fun_layer {
            display-name = "Fun";
            bindings = <
&kp F9          &kp F10         &kp F11         &kp F12         &none           &none           &none           &none           &none           &none           &none           &none 
&kp F5          &kp F6          &kp F7          &kp F8          &kp F17         &trans          &trans          &none           &kp RGUI        &kp RALT        &kp RCTL        &kp RSHFT
&kp F1          &kp F2          &kp F3          &kp F4          &kp F16         &trans          &trans          &none           &none           &none           &none           &none 
                                &kp F13         &kp F14         &kp F15         &trans          &trans          &trans          &none           &none 
            >;
        };

        mse_layer {
            display-name = "Mouse";
            bindings = <
&none           &none           &none           &none           &none           &none           &none           &none           &none           &msc SCRL_UP    &none           &none 
&kp LSHFT       &kp LCTRL       &kp LALT        &kp LGUI        &none           &trans          &trans          &none           &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_RIGHT &none 
&none           &none           &none           &trans          &none           &trans          &trans          &none           &none           &none           &none           &none 
                                &none           &trans          &none           &trans          &trans          &mkp MCLK       &mkp LCLK       &mkp RCLK
            >;
        };

        win_layer {
            display-name = "Win";
            bindings = <
&none           &none           &none           &none           &none           &none           &none           &kp LS(F18)     &kp F19         &kp LS(F19)     &kp F20         &kp LS(F20)
&none           &kp LCTRL       &kp LALT        &kp LGUI        &none           &trans          &trans          &kp F16         &kp LS(F16)     &kp F17         &kp LS(F17)     &kp F18
&none           &none           &none           &none           &none           &trans          &trans          &kp LS(F13)     &kp F14         &kp LS(F14)     &kp F15         &kp LS(F15)
                                &trans          &none           &none           &to DEF         &to DEF         &kp LS(LG(TAB)) &kp F13         &kp LG(TAB)
            >;
        };

        adm_layer {
            display-name = "Admin";
            bindings = <
&none           &none           &kp C_BRI_UP    &kp C_VOL_UP    &none           &none           &none           &none           &none           &none           &none           &none
&none           &none           &kp C_BRI_DN    &kp C_VOL_DN    &none           &trans          &trans          &none           &none           &none           &none           &none
&none           &none           &none           &kp C_MUTE      &none           &trans          &trans          &none           &none           &none           &none           &none
                                &none           &none           &none           &to DEF         &to DEF         &none           &none           &trans 
            >;
        };
        
        wsd_layer {
            display-name = "WASD";
            bindings = <
&kp Q           &kp W           &kp E           &kp R           &kp T           &none           &none           &kp Y           &kp U           &kp I           &kp O           &kp P
&kp A           &kp S           &kp D           &kp F           &kp G           &none           &none           &kp H           &kp J           &kp K           &kp L           &kp SEMI  
&kp Z           &kp X           &kp C           &kp V           &kp B           &none           &none           &kp N           &kp M           &kp COMMA       &kp DOT         &kp SLASH  
                                &kp ESC         &kp SPACE       &kp TAB         &to DEF         &to DEF         &kp BSPC        &kp SPACE       &kp RET  
            >;
        };

    };
};

